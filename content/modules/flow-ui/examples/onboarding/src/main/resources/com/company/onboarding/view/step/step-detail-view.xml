<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://stepDetailView.title"
      focusComponent="form">
    <data>
        <instance id="stepDc"
                  class="com.company.onboarding.entity.Step">
            <fetchPlan extends="_base"/>
            <loader/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="commitAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="stepDc">
            <textField id="nameField" property="name"/>
            <textField id="durationField" property="duration"/>
            <textField id="sortValueField" property="sortValue"/>
            <textField property="factor"/>
        </formLayout>
        <hbox id="detailActions">
            <!-- tag::keyboard-shortcuts[] -->
            <button id="commitAndCloseBtn" action="commitAction"
                    focusShortcut="META-ENTER"/> <!--1-->
            <button id="closeBtn" action="closeAction"
                    shortcutCombination="SHIFT-ESCAPE"/> <!--2-->
            <!-- end::keyboard-shortcuts[] -->
        </hbox>
    </layout>
</view>
