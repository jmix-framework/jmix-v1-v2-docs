<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://multiSelectListBoxView.title">
    <!-- tag::data[] -->
    <data>
        <!-- end::data[] -->
        <!-- tag::hobbiesDc[] -->
        <collection class="com.company.onboarding.entity.Hobby" id="hobbiesDc"> <!--1-->
            <fetchPlan extends="_base"/>
            <loader id="hobbiesDl">
                <query>
                    <![CDATA[select e from Hobby e]]>
                </query>
            </loader>
        </collection>
        <!-- end::hobbiesDc[] -->
        <collection id="usersDc" class="com.company.onboarding.entity.User">
            <loader id="usersDl" readOnly="true">
                <query>
                    <![CDATA[select e from User e]]>
                </query>
            </loader>
            <fetchPlan extends="_base"/>
        </collection>
        <!-- tag::data[] -->
    </data>
    <!-- end::data[] -->
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <!-- tag::layout[] -->
    <layout>
        <!-- end::layout[] -->
        <!-- tag::basics[] -->
        <multiSelectListBox itemsContainer="hobbiesDc"/> <!--2-->
        <!-- end::basics[] -->
        <multiSelectListBox id="multiSelectListBox" itemsContainer="usersDc"/>
        <multiSelectListBox id="mSelectListBox" itemsContainer="usersDc"/>
        <!-- tag::layout[] -->
    </layout>
    <!-- end::layout[] -->
</view>