<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://iconsView.title">
    <layout>
        <hbox>
            <!-- tag::declarative-1[] -->
            <icon icon="USER"/>
            <button text="Approve" icon="CHECK"/>
            <fileUploadField uploadText="Upload file" uploadIcon="UPLOAD"/>
            <!-- end::declarative-1[] -->
        </hbox>
        <hbox>
            <!-- tag::declarative-2[] -->
            <icon icon="vaadin:user"/>
            <button text="Approve" icon="lumo:checkmark"/>
            <fileUploadField uploadText="Upload file" uploadIcon="vaadin:upload"/>
            <!-- end::declarative-2[] -->
        </hbox>

        <hbox>
            <!-- tag::declarative-3[] -->
            <button text="Approve">
                <icon>
                    <icon icon="CHECK"/>
                </icon>
            </button>
            <button text="Start">
                <icon>
                    <svgIcon resource="/icons/jmix-icon.svg"/>
                </icon>
            </button>
            <button text="Download">
                <prefix>
                    <fontIcon fontFamily="lumo-icons" charCode="ea17"/>
                </prefix>
            </button>
            <button text="Create">
                <icon>
                    <image resource="/icons/icon.png" width="24px"/>
                </icon>
            </button>
            <!-- end::declarative-3[] -->
        </hbox>

        <!-- tag::programmatic[] -->
        <button id="helperButton" text="Help"/>
        <button id="editorButton" text="Edit"/>

        <dropdownButton id="settingsButton" text="Settings menu">
            <items>
                <textItem id="saveItem" text="Save"/>
                <textItem id="deleteItem" text="Delete"/>
            </items>
        </dropdownButton>
        <!-- end::programmatic[] -->

        <hbox>
            <!-- tag::sprite[] -->
            <icon icon="my-icons:star"/>
            <icon icon="my-icons:heart"/>
            <icon icon="my-icons:circle"/>
            <!-- end::sprite[] -->
        </hbox>

        <!-- tag::programmatic-sprite[] -->
        <button id="spriteIconButton" text="Sprite Icon"/>
        <!-- end::programmatic-sprite[] -->

        <!-- tag::declarative-standalone-1[] -->
        <svgIcon resource="/icons/tree.svg"/>
        <!-- end::declarative-standalone-1[] -->

        <!-- tag::declarative-standalone-2[] -->
        <button text="Click!">
            <icon>
                <svgIcon resource="/icons/tree.svg"/>
            </icon>
        </button>
        <!-- end::declarative-standalone-2[] -->

        <!-- tag::declarative-standalone-3[] -->
        <button text="Click!">
            <prefix>
                <svgIcon resource="/icons/tree.svg"/>
            </prefix>
        </button>
        <!-- end::declarative-standalone-3[] -->

        <!-- tag::programmatic-standalone[] -->
        <button id="standaloneIconButton" text="Click!"/>
        <!-- end::programmatic-standalone[] -->

        <!-- tag::font-icon[] -->
        <fontIcon fontFamily="Material Icons Outlined" charCode="e8b6"/>
        <fontIcon fontFamily="Material Icons Outlined" ligature="search"/>
        <!-- end::font-icon[] -->

        <!-- tag::font-icon-1[] -->
        <fontIcon fontFamily="lumo-icons" charCode="ea17"/>
        <!-- end::font-icon-1[] -->

        <!-- tag::font-icon-2[] -->
        <button text="Download">
            <icon>
                <fontIcon fontFamily="lumo-icons" charCode="ea17"/>
            </icon>
        </button>
        <!-- end::font-icon-2[] -->

        <!-- tag::font-icon-3[] -->
        <button text="Download">
            <suffix>
                <fontIcon fontFamily="lumo-icons" charCode="ea17"/>
            </suffix>
        </button>
        <!-- end::font-icon-3[] -->
    </layout>
</view>